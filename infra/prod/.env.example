# Copy to /opt/relay/.env on the server (chmod 600). Never commit the real file.

# Public hostname. Its DNS A record must point at the instance's Elastic IP before first start.
RELAY_DOMAIN=relay.example.com
# Let's Encrypt contact address.
ACME_EMAIL=you@example.com

POSTGRES_USER=relay
# Generate with: openssl rand -base64 32 | tr -d '/+='
# Letters and digits only, so it is safe inside the Npgsql connection string.
POSTGRES_PASSWORD=
POSTGRES_DB=relaydb
